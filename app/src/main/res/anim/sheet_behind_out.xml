<?xml version="1.0" encoding="utf-8"?>
<!-- L'appli recule légèrement derrière le volet de la télécommande -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320" android:interpolator="@android:interpolator/decelerate_cubic">
    <scale android:fromXScale="1" android:toXScale="0.94" android:fromYScale="1" android:toYScale="0.94" android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0.5" />
</set>
