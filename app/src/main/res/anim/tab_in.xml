<?xml version="1.0" encoding="utf-8"?>
<!-- Passage d'un onglet à l'autre : fondu et légère montée -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220" android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <translate android:fromYDelta="2%p" android:toYDelta="0" />
</set>
