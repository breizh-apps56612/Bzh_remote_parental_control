<?xml version="1.0" encoding="utf-8"?>
<!-- L'appli revient au premier plan quand la télécommande se ferme -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260" android:interpolator="@android:interpolator/decelerate_cubic">
    <scale android:fromXScale="0.94" android:toXScale="1" android:fromYScale="0.94" android:toYScale="1" android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0.5" android:toAlpha="1" />
</set>
