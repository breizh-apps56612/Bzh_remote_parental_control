<?xml version="1.0" encoding="utf-8"?>
<!-- Télécommande : monte du bas de l'écran comme un volet -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320" android:interpolator="@android:interpolator/decelerate_cubic">
    <translate android:fromYDelta="100%p" android:toYDelta="0" />
    <alpha android:fromAlpha="0.6" android:toAlpha="1" />
</set>
