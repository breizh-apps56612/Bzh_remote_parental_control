<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/bg" /></shape></item>
    <!-- halo violet discret en haut de l'écran -->
    <item android:gravity="top" android:height="420dp">
