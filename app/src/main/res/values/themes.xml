<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Telecommande" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryVariant">@color/bg</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="materialAlertDialogTheme">@style/Telecommande.Dialog</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="alertDialogTheme">@style/Telecommande.Dialog</item>
    </style>

    <style name="Theme.Telecommande.Remote" parent="Theme.Telecommande" />

    <!--
      Télécommande : un volet toujours sombre (comme une vraie télécommande) qui monte du bas et redescend,
      pour ne jamais la confondre avec les écrans de l'appli, qui restent clairs.
    -->
    <style name="Theme.Telecommande.RemoteSheet" parent="Theme.Telecommande">
        <item name="android:windowAnimationStyle">@style/RemoteSheetAnimation</item>
    </style>
    <style name="RemoteSheetAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/sheet_up</item>
        <item name="android:activityOpenExitAnimation">@anim/sheet_behind_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/sheet_behind_in</item>
        <item name="android:activityCloseExitAnimation">@anim/sheet_down</item>
    </style>

    <!-- Boîtes de dialogue : coins arrondis, fond de carte, boutons violets -->
    <style name="Telecommande.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="buttonBarPositiveButtonStyle">@style/Telecommande.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Telecommande.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Telecommande.DialogButton</item>
    </style>
    <style name="Telecommande.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Écran invisible utilisé pour la vérification d'identité (code parent oublié) -->
    <style name="Theme.Telecommande.Invisible" parent="Theme.Telecommande">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Touche ronde de la barre du bas / de l'en-tête -->
    <style name="NavKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/ink</item>
    </style>

    <!-- Touche du dock de la télécommande : icône + petit libellé -->
    <style name="DockKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_dock_key</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
    </style>
    <style name="DockIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/ink</item>
    </style>
    <style name="DockLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="RemoteKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
