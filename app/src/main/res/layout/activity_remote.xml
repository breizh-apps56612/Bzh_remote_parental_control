<?xml version="1.0" encoding="utf-8"?>
<!--
  Télécommande — maquette « Aurora » (C-Remote).
  Haut : retour, TV (pilule), plus, veille. Puis la carte « En cours » et le grand pavé tactile.
  Zone du pouce : Retour TV · volume (− muet +) · Accueil TV, puis le dock CH − · Applis · MICRO · Lecture · CH +.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipChildren="false"
    android:orientation="vertical">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Revenir à l'accueil de l'appli"
            android:elevation="2dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <LinearLayout
            android:id="@+id/deviceChip"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/stateDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sora_semibold"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/muted" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Plus : clavier, souris, touches, réglages, aide"
            android:elevation="2dp"
            android:src="@drawable/ic_more"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_power"
            android:contentDescription="Marche / veille (appui long : allumer)"
            android:src="@drawable/ic_power"
            app:tint="@color/power" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="6dp"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Ce qui passe sur la TV + raccourcis du moment -->
    <LinearLayout
        android:id="@+id/contextPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="14dp" />

    <!-- Grand pavé tactile -->
    <fr.paul.telecommande.ui.TouchpadView
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:minHeight="160dp" />

    <!-- Retour TV · volume · Accueil TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Retour (touche de la TV)"
            android:elevation="2dp"
            android:src="@drawable/ic_return"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rocker"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton android:id="@+id/btnVolDown" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_rocker_btn" android:contentDescription="Volume moins"
                android:src="@drawable/ic_vol_down" app:tint="@color/rocker_ink" />

            <LinearLayout
                android:id="@+id/btnMute"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rocker_btn"
                android:clickable="true"
                android:contentDescription="Muet"
                android:focusable="true"
                android:gravity="center">

                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no"
                    android:src="@drawable/ic_mute" app:tint="@color/muted" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:importantForAccessibility="no" android:fontFamily="@font/sora_semibold" android:letterSpacing="0.12"
                    android:text="VOLUME" android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>

            <ImageButton android:id="@+id/btnVolUp" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_rocker_btn" android:contentDescription="Volume plus"
                android:src="@drawable/ic_vol_up" app:tint="@color/accent" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Accueil (touche de la TV)"
            android:elevation="2dp"
            android:src="@drawable/ic_home"
            app:tint="@color/ink" />
    </LinearLayout>

    <!-- Dock : CH − · Applis · MICRO · Lecture · CH + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout android:id="@+id/btnChDown" style="@style/DockKey" android:contentDescription="Chaîne précédente">
            <ImageView style="@style/DockIcon" android:src="@drawable/ic_chevron_down" />
            <TextView style="@style/DockLabel" android:text="CH −" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnApps" style="@style/DockKey" android:contentDescription="Applis de la TV">
            <ImageView android:id="@+id/btnAppsIcon" style="@style/DockIcon" android:src="@drawable/ic_apps" />
            <TextView android:id="@+id/btnAppsLabel" style="@style/DockLabel" android:text="Applis" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_fab"
                android:contentDescription="Recherche vocale (maintenir pour parler)"
                android:elevation="10dp"
                android:src="@drawable/ic_mic"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <LinearLayout android:id="@+id/btnPlay" style="@style/DockKey" android:contentDescription="Lecture / pause">
            <ImageView style="@style/DockIcon" android:src="@drawable/ic_playpause" />
            <TextView style="@style/DockLabel" android:text="Lecture" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnChUp" style="@style/DockKey" android:contentDescription="Chaîne suivante">
            <ImageView style="@style/DockIcon" android:src="@drawable/ic_chevron_up" />
            <TextView style="@style/DockLabel" android:text="CH +" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
