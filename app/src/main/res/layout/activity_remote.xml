<?xml version="1.0" encoding="utf-8"?>
<!--
  Télécommande 2.6 « Perle » — un volet clair et nacré, posé par-dessus l'appli.
  Haut : poignée ; fermer, pastille « TÉLÉCOMMANDE · TV du salon », plus, veille.
  Puis la carte « En cours » et le grand pavé (chaînes à gauche, volume à droite, OK au centre).
  En bas, une capsule flottante : Retour TV · Accueil TV · MICRO (en relief) · Lecture · Applis.
  Les volumes et ombres sont posés en code (RemoteActivity.premiumLook).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_remote"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Poignée : on comprend tout de suite que c'est un volet qui se referme vers le bas -->
    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_handle"
        android:importantForAccessibility="no" />

    <!-- En-tête -->
    <LinearLayout
        android:id="@+id/remoteHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_remote_round"
            android:contentDescription="Fermer la télécommande et revenir à l'appli"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/ink" />

        <LinearLayout
            android:id="@+id/deviceChip"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_remote_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:letterSpacing="0.18"
                android:text="TÉLÉCOMMANDE"
                android:textColor="@color/accent"
                android:textSize="9.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/stateDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:id="@+id/deviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sora_semibold"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/muted" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_remote_round"
            android:contentDescription="Plus : clavier, souris, touches, réglages, aide"
            android:src="@drawable/ic_more"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_remote_power"
            android:contentDescription="Marche / veille (appui long : allumer)"
            android:src="@drawable/ic_power"
            app:tint="@color/power" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="6dp"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Ce qui passe sur la TV + raccourcis du moment -->
    <LinearLayout
        android:id="@+id/contextPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_remote_card"
        android:orientation="vertical"
        android:padding="16dp" />

    <!-- Grand pavé tactile -->
    <fr.paul.telecommande.ui.TouchpadView
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:minHeight="160dp" />

    <!-- Dock flottant : une capsule blanche, le micro en relief au centre -->
    <FrameLayout
        android:id="@+id/remoteDock"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/dockPill"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_dock"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout android:id="@+id/btnBack" style="@style/DockKey" android:contentDescription="Retour, touche de la TV">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_return" />
                <TextView style="@style/DockLabel" android:text="Retour TV" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnHome" style="@style/DockKey" android:contentDescription="Accueil de la TV, touche de la TV">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_tv_home" />
                <TextView style="@style/DockLabel" android:text="Accueil TV" />
            </LinearLayout>

            <!-- Place réservée au micro -->
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25" />

            <LinearLayout android:id="@+id/btnPlay" style="@style/DockKey" android:contentDescription="Lecture / pause">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_playpause" />
                <TextView style="@style/DockLabel" android:text="Lecture" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnApps" style="@style/DockKey" android:contentDescription="Applis de la TV">
                <ImageView android:id="@+id/btnAppsIcon" style="@style/DockIcon" android:src="@drawable/ic_apps" />
                <TextView android:id="@+id/btnAppsLabel" style="@style/DockLabel" android:text="Applis" />
            </LinearLayout>
        </LinearLayout>

        <!-- Micro : bouton signature indigo → sarcelle, cerclé de blanc, qui dépasse du dock -->
        <FrameLayout
            android:id="@+id/micRing"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_mic_ring"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_fab"
                android:contentDescription="Recherche vocale (maintenir pour parler)"
                android:src="@drawable/ic_mic"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
