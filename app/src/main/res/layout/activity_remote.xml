<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <!-- En-tête : appareil (pilule, changer), marche/veille, menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/deviceChip"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/stateDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/muted" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_power"
            android:contentDescription="Marche / veille (appui long : allumer)"
            android:src="@drawable/ic_power"
            app:tint="@color/power" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Plus d'options"
            android:rotation="90"
            android:src="@drawable/ic_more"
            app:tint="@color/ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Carte « En cours » synchronisée avec la TV + suggestions -->
    <LinearLayout
        android:id="@+id/contextPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp" />

    <fr.paul.telecommande.ui.TouchpadView
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:minHeight="150dp" />

    <!-- VOL | boutons ronds | CH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="196dp"
            android:background="@drawable/bg_rocker"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton android:id="@+id/btnVolUp" android:layout_width="68dp" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_rocker_btn" android:contentDescription="Volume plus"
                android:src="@drawable/ic_chevron_up" app:tint="@color/rocker_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no"
                android:text="VOL" android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.15" android:fontFamily="sans-serif-medium" />
            <ImageButton android:id="@+id/btnVolDown" android:layout_width="68dp" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_rocker_btn" android:contentDescription="Volume moins"
                android:src="@drawable/ic_chevron_down" app:tint="@color/rocker_ink" />
        </LinearLayout>

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:columnCount="2">

            <ImageButton android:id="@+id/btnHome" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="3dp"
                android:background="@drawable/bg_round" android:contentDescription="Accueil" android:src="@drawable/ic_home" app:tint="@color/ink" />
            <ImageButton android:id="@+id/btnBack" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="3dp"
                android:background="@drawable/bg_round" android:contentDescription="Retour" android:src="@drawable/ic_return" app:tint="@color/ink" />
            <ImageButton android:id="@+id/btnMute" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="3dp"
                android:background="@drawable/bg_round" android:contentDescription="Muet" android:src="@drawable/ic_mute" app:tint="@color/ink" />
            <ImageButton android:id="@+id/btnPlay" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="3dp"
                android:background="@drawable/bg_round" android:contentDescription="Lecture / pause" android:src="@drawable/ic_playpause" app:tint="@color/ink" />
            <ImageButton android:id="@+id/btnMic" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="3dp"
                android:background="@drawable/bg_round" android:contentDescription="Recherche vocale (maintenir pour parler)" android:src="@drawable/ic_mic" app:tint="@color/ink" />
            <ImageButton android:id="@+id/btnMore" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="3dp"
                android:background="@drawable/bg_round" android:contentDescription="Plus : clavier, souris, 123, couleurs" android:src="@drawable/ic_more" app:tint="@color/ink" />
        </GridLayout>

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="196dp"
            android:background="@drawable/bg_rocker"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton android:id="@+id/btnChUp" android:layout_width="68dp" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_rocker_btn" android:contentDescription="Chaîne suivante"
                android:src="@drawable/ic_chevron_up" app:tint="@color/rocker_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no"
                android:text="CH" android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.15" android:fontFamily="sans-serif-medium" />
            <ImageButton android:id="@+id/btnChDown" android:layout_width="68dp" android:layout_height="0dp" android:layout_weight="1"
                android:background="@drawable/bg_rocker_btn" android:contentDescription="Chaîne précédente"
                android:src="@drawable/ic_chevron_down" app:tint="@color/rocker_ink" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav"
        app:elevation="0dp"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemRippleColor="@color/accent_soft"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/remote_nav" />
</LinearLayout>
