<?xml version="1.0" encoding="utf-8"?>
<!-- Les TV et box du réseau local parlent en HTTP simple : on l'autorise. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
